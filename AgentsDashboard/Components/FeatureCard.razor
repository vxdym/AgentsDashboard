@using AgentsDashboard.Models

<div class="card feature-card" @onclick="() => OnOpen.InvokeAsync(Feature)">
    <div class="card-body">
        <div class="card-head">
            <h5 class="card-title">@Feature.Title</h5>
            <StatusBadge Status="Feature.Status" />
        </div>
        <div class="branch">@Feature.BranchName</div>
        <p class="card-text description">@(string.IsNullOrWhiteSpace(Feature.Description) ? "Keine Beschreibung" : Feature.Description)</p>
    </div>
    <div class="card-footer">
        <small class="text-muted">@Feature.CreatedAt.ToString("dd.MM.yyyy")</small>
    </div>
</div>

@code {
    [Parameter] public Feature Feature { get; set; } = null!;
    [Parameter] public EventCallback<Feature> OnOpen { get; set; }
}
