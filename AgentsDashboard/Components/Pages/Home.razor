@page "/"
@using AgentsDashboard.Models

<PageTitle>Salonary Entwicklung</PageTitle>

<div class="toolbar">
    <h1>Features</h1>
    <a class="btn btn-primary" href="feature/neu">Neues Feature erstellen</a>
</div>

@if (features.Count == 0)
{
    <p class="text-muted">Noch keine Features vorhanden.</p>
}
else
{
    @foreach (var group in groups)
    {
        <h6 class="group-title">@group.Key</h6>
        <div class="cards">
            @foreach (var feature in group)
            {
                <FeatureCard Feature="feature"
                             Git="gitInfos.GetValueOrDefault(feature.Id)"
                             DockerRunning="runningProjects.Any(p => p.BelongsTo(feature.WorktreePath))"
                             OnOpen="OpenFeature" />
            }
        </div>
    }
}
